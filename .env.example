# NovaCraft Studio / AI Survivor — generic local configuration
# Copy this file to .env and replace placeholders on your own machine.
# Never commit .env or real credentials.

APP_NAME="NovaCraft Studio — Digital Tools, Services & Merch"
ENVIRONMENT="development"
DATABASE_URL="sqlite:///./ai_survivor_p1.db"

# Replace locally with a long, random secret. Do not reuse this example value.
ADMIN_TOKEN="replace-with-a-long-random-secret"
HIDDEN_ADMIN_PATH="/ops-control-change-this"

# Virtual treasury and risk controls (INR)
INITIAL_CAPITAL=5000.0
EMERGENCY_RESERVE_RATIO=0.20
MAX_SINGLE_ALLOCATION_RATIO=0.30
PAPER_MODE_ONLY=true

# Optional OpenAI-compatible LLM integration
LLM_API_KEY=""
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
LLM_MODEL="gemini-2.5-flash"

# Optional Telegram integration
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
AUTO_CYCLE_INTERVAL_SECONDS=30

# Generic storefront placeholders — replace only if you intentionally configure a store
FAMPAY_UPI_ID="YOUR_DEMO_UPI_ID"
FAMPAY_PAYEE_NAME="Example Demo Store"
BUSINESS_EMAIL="contact@example.com"
PUBLIC_STORE_URL="http://127.0.0.1:8000"
